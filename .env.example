# Copy to .env.local for local development.

# Postgres connection. `npm run dev` starts a local Postgres at this address
# automatically (data lives in .data/postgres). In production use Neon's
# pooled connection string.
DATABASE_URL=postgres://dinner:dinner@localhost:5433/dinner_roulette

# Random 32+ character secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The site's public URL (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3100

# Comma-separated Google emails allowed to sign in before setup is finished.
# After setup, any parent profile's email may also sign in.
ALLOWED_EMAILS=

# Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development and tests only: enables email + password sign-in so you
# don't need Google credentials. Never set this in production.
DEV_LOGIN=false

# Claude API key for AI recipe features (https://console.anthropic.com)
ANTHROPIC_API_KEY=
